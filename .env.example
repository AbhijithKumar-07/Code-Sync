# ==========================================
# Code-Sync Production Environment Configuration
# ==========================================

PORT=5000

# ------------------------------------------
# 1. Judge0 Code Execution Engine (Recommended for Production Sandboxing)
# ------------------------------------------
# Set your self-hosted Judge0 instance URL (e.g., http://your-server-ip:2358)
# OR RapidAPI Judge0 endpoint:
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_or_judge0_key_here
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# ------------------------------------------
# 2. Piston Code Execution Engine (Optional Alternative)
# ------------------------------------------
# If hosting Piston (docker run -d -p 2000:2000 ghcr.io/engineer-man/piston):
# PISTON_API_URL=http://localhost:2000/api/v2/execute

# ------------------------------------------
# 3. Execution Settings
# ------------------------------------------
# Set to 'false' if running in untrusted multi-tenant host without Docker containers
ENABLE_LOCAL_EXECUTION=true
EXECUTION_TIMEOUT_MS=5000
